<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <AssemblyName>DanpheEMR.ServerModel</AssemblyName>
    <RootNamespace>DanpheEMR.ServerModel</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.4.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="4.7.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="4.7.0" />
    <PackageReference Include="Audit.EntityFramework" Version="15.0.5" />
  </ItemGroup>
  
  <!-- Include all CS files in the project -->
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs" />
  </ItemGroup>
  
  <!-- Exclude specific folders from compilation if needed -->
  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
</Project>
