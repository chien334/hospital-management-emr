<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <AssemblyName>DanpheEMR.Sync</AssemblyName>
    <RootNamespace>DanpheEMR.Sync</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.4.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="4.7.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="5.2.7" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="IRDNepal\APIs.cs" />
    <Compile Include="IRDNepal\DanpheDateConverter.cs" />
    <Compile Include="IRDNepal\IRDBillingViewModels.cs" />
    <Compile Include="IRDNepal\IRDNepalDbContext.cs" />
    <Compile Include="IRDNepal\IRD_PHRMBillSaleViewModel.cs" />
    <Compile Include="IRDNepal\PostToIRD.cs" />
    <Compile Include="IRDNepal\SyncLocalData.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="RemoteSync.cs" />
    <Compile Include="SSF\APIs.cs" />
    <Compile Include="SSF\SSF_ClaimBookingViewModel.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DanpheEMR.Core\DanpheEMR.Core.csproj" />
    <ProjectReference Include="..\DanpheEMR.ServerModel\DanpheEMR.ServerModel.csproj" />
  </ItemGroup>
</Project>