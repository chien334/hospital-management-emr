# Build Stage
FROM node:20 AS build
WORKDIR /app

# Copy package files
COPY Frontend/package*.json ./

# Install dependencies using force to override strict peer conflicts if any
RUN npm install --force

# Copy full frontend source
COPY Frontend/ .

# Build standard production Angular package
RUN npx ng build --configuration=production

# Final Runtime Stage
FROM nginx:alpine

# Copy built Angular static assets to NGINX standard directory
COPY --from=build /app/dist/DsfApp /usr/share/nginx/html

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
